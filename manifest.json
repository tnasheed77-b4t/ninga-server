{
  "manifest_version": 3,
  "name": "Ninga",
  "short_name": "Ninga",
  "version": "1.0.0",
  "description": "Paste links to download WAV or MP3 audio with yt-dlp and FFmpeg, automatically detect BPM and musical key, or search the web with Ask Ninga.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Ninga",
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "host_permissions": [
    "https://ninga-audio-api.onrender.com/*"
  ]
}